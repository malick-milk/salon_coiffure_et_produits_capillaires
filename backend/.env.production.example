# CONFIGURATION DE PRODUCTION — modèle. provision.sh en fait /var/www/dabohair/shared/.env
# et remplace les valeurs __…__ par des secrets générés SUR LE SERVEUR (jamais dans Git).
# Contrôle : php artisan app:security-check doit afficher « Configuration prête pour la production ».

APP_NAME="Dabo Hair"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://__DOMAIN__
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Journaux : un fichier par jour, 14 jours ; niveau « warning » (le niveau debug peut écrire des données personnelles)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dabohair
DB_USERNAME=dabohair
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=__DOMAIN__
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Emails (étape 13 : réservations, rappels, enquêtes) : renseigner le service d'envoi choisi (Brevo, Zoho, Mailgun…)
# Tant que MAIL_MAILER=log, les e-mails sont seulement écrits dans les journaux (app:security-check le signale)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@__DOMAIN__"
MAIL_FROM_NAME="${APP_NAME}"

# Le site et l'API sont sur le même domaine (Nginx) : Sanctum reconnaît les requêtes du site
FRONTEND_URL=https://__DOMAIN__
SANCTUM_STATEFUL_DOMAINS=__DOMAIN__,www.__DOMAIN__
CORS_ALLOWED_ORIGINS=https://__DOMAIN__

# SMS (étape 13) : SMS_DRIVER=log tant qu'aucun fournisseur n'est choisi (docs/13_NOTIFICATIONS_ET_AVIS.md)
SMS_DRIVER=log
SMS_SENDER="DABO HAIR"
