# Copier ce fichier en ".env.local" (jamais versionné) et adapter les valeurs.
# Seules les variables préfixées VITE_ sont visibles dans le code du navigateur :
# n'y mettez JAMAIS de secret (mot de passe, clé privée).

# true  = MSW simule l'API : pratique si PHP n'est pas installé.
# false = vraie API Laravel (lancer « php artisan serve » dans backend/, voir docs/06_BACKEND.md §3.1).
# Sans effet en production : le faux serveur n'est jamais inclus dans « npm run build ».
VITE_ENABLE_MOCKS=true
